"""
Giới hạn thời gian sử dụng máy tính - Windows
Yêu cầu: pip install customtkinter pillow
Chạy: python gioihan_sudung.py
"""

import customtkinter as ctk
import tkinter as tk
from tkinter import messagebox
import threading
import time
import json
import os
import sys
import ctypes
import subprocess
from datetime import datetime, timedelta

# ── Cấu hình giao diện ────────────────────────────────────────────
ctk.set_appearance_mode("light")
ctk.set_default_color_theme("blue")

DATA_FILE = os.path.join(os.path.expanduser("~"), ".gioihan_state.json")

# ── Lưu / tải trạng thái (để tiếp tục sau khi đóng app) ──────────
def save_state(state: dict):
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        json.dump(state, f)

def load_state() -> dict | None:
    if not os.path.exists(DATA_FILE):
        return None
    try:
        with open(DATA_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None

def clear_state():
    if os.path.exists(DATA_FILE):
        os.remove(DATA_FILE)

# ── App chính ─────────────────────────────────────────────────────
class App(ctk.CTk):
    def __init__(self):
        super().__init__()
        self.title("Giới hạn thời gian sử dụng")
        self.geometry("500x680")
        self.resizable(False, False)
        self.protocol("WM_DELETE_WINDOW", self.on_close)

        # State
        self.total_sec   = 0
        self.rem_sec     = 0
        self.lock_sec    = 300   # mặc định nghỉ 5 phút
        self.lock_rem    = 0
        self.running     = False
        self.locked      = False
        self.warned_60   = False
        self.warned_10   = False
        self.deadline    = None  # datetime khi hết giờ
        self.lock_until  = None  # datetime khi hết nghỉ

        self.build_ui()
        self.resume_if_needed()
        self.tick()

    # ── Build UI ──────────────────────────────────────────────────
    def build_ui(self):
        self.main_frame = ctk.CTkScrollableFrame(self, fg_color="transparent")
        self.main_frame.pack(fill="both", expand=True, padx=20, pady=20)

        # Tiêu đề
        ctk.CTkLabel(self.main_frame, text="Giới hạn thời gian",
                     font=ctk.CTkFont(size=22, weight="bold")).pack(anchor="w")
        ctk.CTkLabel(self.main_frame, text="App chạy ngầm — tiếp tục đếm kể cả khi đóng cửa sổ.",
                     text_color="gray", font=ctk.CTkFont(size=12)).pack(anchor="w", pady=(2, 20))

        # ── Card: Đặt thời gian sử dụng ──────────────────────────
        self.card("Thời gian sử dụng")

        # Preset buttons
        preset_frame = ctk.CTkFrame(self.main_frame, fg_color="transparent")
        preset_frame.pack(fill="x", pady=(0, 12))
        presets = [("30s", 0,0,30), ("1 phút", 0,1,0), ("5 phút", 0,5,0),
                   ("15 phút", 0,15,0), ("30 phút", 0,30,0),
                   ("1 giờ", 1,0,0), ("2 giờ", 2,0,0), ("3 giờ", 3,0,0)]
        self.preset_btns = []
        row1 = ctk.CTkFrame(preset_frame, fg_color="transparent")
        row1.pack(fill="x", pady=(0,4))
        row2 = ctk.CTkFrame(preset_frame, fg_color="transparent")
        row2.pack(fill="x")
        for i, (label, h, m, s) in enumerate(presets):
            parent = row1 if i < 4 else row2
            btn = ctk.CTkButton(parent, text=label, width=90, height=30,
                                fg_color="transparent", border_width=1,
                                text_color=("gray20","gray80"),
                                border_color="gray70",
                                command=lambda h=h,m=m,s=s,l=label: self.set_preset(h,m,s,l))
            btn.pack(side="left", padx=(0,6))
            self.preset_btns.append(btn)

        # Input giờ : phút : giây
        inp_frame = ctk.CTkFrame(self.main_frame, fg_color="transparent")
        inp_frame.pack(fill="x", pady=(0, 16))
        for col, (var_name, label, mx) in enumerate([
            ("inp_h","Giờ",23), ("inp_m","Phút",59), ("inp_s","Giây",59)
        ]):
            col_f = ctk.CTkFrame(inp_frame, fg_color="transparent")
            col_f.pack(side="left", expand=True)
            ctk.CTkLabel(col_f, text=label, font=ctk.CTkFont(size=12),
                         text_color="gray").pack()
            var = tk.StringVar(value="00")
            entry = ctk.CTkEntry(col_f, textvariable=var, width=120, height=60,
                                 font=ctk.CTkFont(size=30, weight="bold"),
                                 justify="center")
            entry.pack(pady=4)
            setattr(self, var_name, var)
            setattr(self, var_name + "_entry", entry)
            if col < 2:
                ctk.CTkLabel(inp_frame, text=":",
                             font=ctk.CTkFont(size=30, weight="bold"),
                             text_color="gray").pack(side="left", pady=(16,0))

        # ── Card: Đặt thời gian nghỉ ──────────────────────────────
        self.card("Thời gian nghỉ ngơi (khi bị khoá)")

        lock_inp = ctk.CTkFrame(self.main_frame, fg_color="transparent")
        lock_inp.pack(fill="x", pady=(0,16))
        for col, (var_name, label, mx) in enumerate([
            ("lock_h","Giờ",23), ("lock_m","Phút",59), ("lock_s","Giây",59)
        ]):
            col_f = ctk.CTkFrame(lock_inp, fg_color="transparent")
            col_f.pack(side="left", expand=True)
            ctk.CTkLabel(col_f, text=label, font=ctk.CTkFont(size=12),
                         text_color="gray").pack()
            var = tk.StringVar(value="05" if label=="Phút" else "00")
            entry = ctk.CTkEntry(col_f, textvariable=var, width=120, height=60,
                                 font=ctk.CTkFont(size=30, weight="bold"),
                                 justify="center")
            entry.pack(pady=4)
            setattr(self, var_name, var)
            if col < 2:
                ctk.CTkLabel(lock_inp, text=":",
                             font=ctk.CTkFont(size=30, weight="bold"),
                             text_color="gray").pack(side="left", pady=(16,0))

        # ── Card: Trạng thái ──────────────────────────────────────
        self.card("Trạng thái")

        stat_frame = ctk.CTkFrame(self.main_frame, fg_color="transparent")
        stat_frame.pack(fill="x", pady=(0,12))
        self.lbl_total = self.stat_box(stat_frame, "Tổng thời gian", "00:00:00")
        self.lbl_left  = self.stat_box(stat_frame, "Còn lại",        "00:00:00")
        self.lbl_pct   = self.stat_box(stat_frame, "Phần trăm còn",  "100%")

        self.progress = ctk.CTkProgressBar(self.main_frame, height=8)
        self.progress.set(1.0)
        self.progress.pack(fill="x", pady=(0,12))

        self.lbl_warn = ctk.CTkLabel(self.main_frame, text="", text_color="orange",
                                     font=ctk.CTkFont(size=13))
        self.lbl_warn.pack(anchor="w", pady=(0,8))

        # Nút bắt đầu / đặt lại
        self.btn_start = ctk.CTkButton(self.main_frame, text="Bắt đầu đếm giờ",
                                       height=44, font=ctk.CTkFont(size=15, weight="bold"),
                                       command=self.start_timer)
        self.btn_start.pack(fill="x", pady=(0,8))

        self.btn_reset = ctk.CTkButton(self.main_frame, text="Đặt lại",
                                       height=36, fg_color="transparent",
                                       border_width=1, border_color="gray70",
                                       text_color=("gray20","gray80"),
                                       command=self.reset_timer)
        self.btn_reset.pack(fill="x")
        self.btn_reset.pack_forget()

        # Thông báo hệ thống nhỏ (label cuối)
        self.lbl_status = ctk.CTkLabel(self.main_frame, text="",
                                       text_color="gray", font=ctk.CTkFont(size=11))
        self.lbl_status.pack(anchor="w", pady=(12,0))

    def card(self, title):
        ctk.CTkLabel(self.main_frame, text=title.upper(),
                     font=ctk.CTkFont(size=11, weight="bold"),
                     text_color="gray").pack(anchor="w", pady=(16,6))
        ctk.CTkFrame(self.main_frame, height=1, fg_color="gray85").pack(fill="x", pady=(0,10))

    def stat_box(self, parent, label, value):
        f = ctk.CTkFrame(parent, fg_color=("#f7f7f3","#2a2a2a"), corner_radius=10)
        f.pack(side="left", expand=True, fill="x", padx=(0,8))
        lbl = ctk.CTkLabel(f, text=value, font=ctk.CTkFont(size=16, weight="bold"))
        lbl.pack(pady=(10,2))
        ctk.CTkLabel(f, text=label, font=ctk.CTkFont(size=11), text_color="gray").pack(pady=(0,10))
        return lbl

    # ── Preset ────────────────────────────────────────────────────
    def set_preset(self, h, m, s, label):
        self.inp_h.set(f"{h:02d}")
        self.inp_m.set(f"{m:02d}")
        self.inp_s.set(f"{s:02d}")

    # ── Parse inputs ──────────────────────────────────────────────
    def parse_use_time(self):
        try:
            h = max(0, min(23, int(self.inp_h.get() or 0)))
            m = max(0, min(59, int(self.inp_m.get() or 0)))
            s = max(0, min(59, int(self.inp_s.get() or 0)))
            return h * 3600 + m * 60 + s
        except ValueError:
            return 0

    def parse_lock_time(self):
        try:
            h = max(0, min(23, int(self.lock_h.get() or 0)))
            m = max(0, min(59, int(self.lock_m.get() or 0)))
            s = max(0, min(59, int(self.lock_s.get() or 0)))
            return h * 3600 + m * 60 + s
        except ValueError:
            return 300

    # ── Start ─────────────────────────────────────────────────────
    def start_timer(self):
        total = self.parse_use_time()
        if total < 1:
            messagebox.showwarning("Lỗi", "Vui lòng đặt ít nhất 1 giây!")
            return
        lock = self.parse_lock_time()
        if lock < 1:
            messagebox.showwarning("Lỗi", "Vui lòng đặt thời gian nghỉ ít nhất 1 giây!")
            return

        self.total_sec  = total
        self.rem_sec    = total
        self.lock_sec   = lock
        self.running    = True
        self.warned_60  = False
        self.warned_10  = False
        self.deadline   = datetime.now() + timedelta(seconds=total)

        save_state({
            "deadline":   self.deadline.isoformat(),
            "total_sec":  self.total_sec,
            "lock_sec":   self.lock_sec,
        })

        self.lbl_total.configure(text=self.fmt(self.total_sec))
        self.btn_start.configure(state="disabled")
        self.btn_reset.pack(fill="x")
        self.set_inputs_state("disabled")
        self.lbl_status.configure(text="Đang chạy ngầm — an toàn khi đóng cửa sổ.")

    # ── Tick (mỗi giây) ───────────────────────────────────────────
    def tick(self):
        if self.running and not self.locked:
            now = datetime.now()
            self.rem_sec = max(0, int((self.deadline - now).total_seconds()))

            pct = self.rem_sec / self.total_sec if self.total_sec > 0 else 0
            self.lbl_left.configure(text=self.fmt(self.rem_sec))
            self.lbl_pct.configure(text=f"{int(pct*100)}%")
            self.progress.set(pct)

            if self.rem_sec <= 10:
                self.progress.configure(progress_color="#e24b4a")
                self.lbl_warn.configure(text="🔴 Còn dưới 10 giây — máy sắp khoá!", text_color="#e24b4a")
                if not self.warned_10:
                    self.warned_10 = True
                    self.notify("Cảnh báo!", "Còn 10 giây — màn hình sắp khoá!")
            elif self.rem_sec <= 60:
                self.progress.configure(progress_color="#ba7517")
                self.lbl_warn.configure(text="⚠ Còn dưới 1 phút — hãy lưu công việc!", text_color="#ba7517")
                if not self.warned_60:
                    self.warned_60 = True
                    self.notify("Sắp hết giờ", "Còn dưới 1 phút — hãy lưu công việc!")
            else:
                self.progress.configure(progress_color="#1f6aa5")
                self.lbl_warn.configure(text="")

            if self.rem_sec <= 0:
                self.do_lock()

        elif self.locked:
            now = datetime.now()
            self.lock_rem = max(0, int((self.lock_until - now).total_seconds()))
            if hasattr(self, "lock_win") and self.lock_win.winfo_exists():
                self.lock_win.lbl_cd.configure(text=self.fmt(self.lock_rem))
            if self.lock_rem <= 0:
                self.do_unlock(auto=True)

        self.after(1000, self.tick)

    # ── Khoá màn hình ─────────────────────────────────────────────
    def do_lock(self):
        self.running = False
        self.locked  = True
        self.lock_until = datetime.now() + timedelta(seconds=self.lock_sec)
        self.lock_rem   = self.lock_sec
        clear_state()

        save_state({
            "locked":     True,
            "lock_until": self.lock_until.isoformat(),
            "lock_sec":   self.lock_sec,
        })

        self.show_lock_window()

    def show_lock_window(self):
        self.lock_win = ctk.CTkToplevel(self)
        self.lock_win.title("Đã hết giờ")
        self.lock_win.attributes("-fullscreen", True)
        self.lock_win.attributes("-topmost", True)
        self.lock_win.protocol("WM_DELETE_WINDOW", lambda: None)
        self.lock_win.grab_set()

        # Tối màn hình
        self.lock_win.configure(fg_color="#0a0a0a")

        frame = ctk.CTkFrame(self.lock_win, fg_color="#1a1a1a", corner_radius=24,
                             width=400, height=460)
        frame.place(relx=0.5, rely=0.5, anchor="center")
        frame.pack_propagate(False)

        ctk.CTkLabel(frame, text="🔒", font=ctk.CTkFont(size=48)).pack(pady=(40,8))
        ctk.CTkLabel(frame, text="Đã hết giờ sử dụng",
                     font=ctk.CTkFont(size=22, weight="bold"),
                     text_color="white").pack()
        ctk.CTkLabel(frame, text="Hãy đứng dậy nghỉ ngơi một chút!\nMàn hình sẽ tự mở khoá sau:",
                     text_color="gray70", font=ctk.CTkFont(size=13),
                     justify="center").pack(pady=(8,20))

        self.lock_win.lbl_cd = ctk.CTkLabel(frame, text=self.fmt(self.lock_rem),
                                             font=ctk.CTkFont(size=56, weight="bold"),
                                             text_color="white")
        self.lock_win.lbl_cd.pack()

        ctk.CTkLabel(frame, text="thời gian nghỉ còn lại",
                     text_color="gray60", font=ctk.CTkFont(size=12)).pack(pady=(4,28))

        ctk.CTkButton(frame, text="Mở khoá ngay (bỏ qua nghỉ ngơi)",
                      fg_color="transparent", border_width=1,
                      border_color="gray50", text_color="gray60",
                      hover_color="#2a2a2a",
                      command=lambda: self.do_unlock(auto=False)).pack(padx=32, fill="x")

        ctk.CTkLabel(frame, text="", height=20).pack()

    def do_unlock(self, auto=True):
        self.locked = False
        clear_state()
        if hasattr(self, "lock_win") and self.lock_win.winfo_exists():
            self.lock_win.grab_release()
            self.lock_win.destroy()
        self.reset_timer(keep_settings=True)
        if auto:
            self.lbl_status.configure(text="Nghỉ đủ rồi! Bạn có thể bắt đầu phiên mới.")

    # ── Reset ─────────────────────────────────────────────────────
    def reset_timer(self, keep_settings=False):
        self.running = False
        self.locked  = False
        clear_state()

        self.btn_start.configure(state="normal")
        self.btn_reset.pack_forget()
        self.set_inputs_state("normal")
        self.lbl_warn.configure(text="")
        self.progress.set(1.0)
        self.progress.configure(progress_color="#1f6aa5")

        if not keep_settings:
            self.lbl_total.configure(text="00:00:00")
            self.lbl_left.configure(text="00:00:00")
            self.lbl_pct.configure(text="100%")
            self.lbl_status.configure(text="")
        else:
            self.lbl_total.configure(text="00:00:00")
            self.lbl_left.configure(text="00:00:00")
            self.lbl_pct.configure(text="100%")
            self.lbl_status.configure(text="Đã đặt lại. Chọn thời gian mới để bắt đầu.")

    def set_inputs_state(self, state):
        for name in ["inp_h_entry", "inp_m_entry", "inp_s_entry"]:
            if hasattr(self, name):
                getattr(self, name).configure(state=state)
        for btn in self.preset_btns:
            btn.configure(state=state)

    # ── Tiếp tục sau khi tắt app ──────────────────────────────────
    def resume_if_needed(self):
        state = load_state()
        if not state:
            return

        now = datetime.now()

        # Đang bị khoá
        if state.get("locked"):
            lock_until = datetime.fromisoformat(state["lock_until"])
            if lock_until > now:
                self.locked     = True
                self.lock_until = lock_until
                self.lock_sec   = state.get("lock_sec", 300)
                self.lock_rem   = int((lock_until - now).total_seconds())
                self.after(500, self.show_lock_window)
            else:
                clear_state()
            return

        # Đang đếm giờ
        if state.get("deadline"):
            deadline = datetime.fromisoformat(state["deadline"])
            if deadline > now:
                self.total_sec = state["total_sec"]
                self.lock_sec  = state.get("lock_sec", 300)
                self.deadline  = deadline
                self.rem_sec   = int((deadline - now).total_seconds())
                self.running   = True
                self.warned_60 = self.rem_sec < 60
                self.warned_10 = self.rem_sec < 10
                self.lbl_total.configure(text=self.fmt(self.total_sec))
                self.btn_start.configure(state="disabled")
                self.btn_reset.pack(fill="x")
                self.set_inputs_state("disabled")
                self.lbl_status.configure(
                    text=f"Tiếp tục phiên cũ — còn {self.fmt(self.rem_sec)}.")
            else:
                self.after(500, self.do_lock)

    # ── Đóng cửa sổ (chạy ngầm) ──────────────────────────────────
    def on_close(self):
        if self.running or self.locked:
            self.withdraw()  # ẩn cửa sổ, tiếp tục chạy ngầm
        else:
            self.destroy()

    # ── Thông báo Windows ─────────────────────────────────────────
    def notify(self, title, msg):
        threading.Thread(target=self._notify, args=(title, msg), daemon=True).start()

    def _notify(self, title, msg):
        try:
            ctypes.windll.user32.MessageBoxW(0, msg, title, 0x00040000 | 0x30)
        except Exception:
            pass

    # ── Format thời gian ──────────────────────────────────────────
    @staticmethod
    def fmt(s):
        s = max(0, int(s))
        h = s // 3600
        m = (s % 3600) // 60
        sec = s % 60
        return f"{h:02d}:{m:02d}:{sec:02d}"


# ── Entry point ───────────────────────────────────────────────────
if __name__ == "__main__":
    app = App()
    app.mainloop()